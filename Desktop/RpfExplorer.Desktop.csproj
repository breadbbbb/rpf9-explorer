<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>rpf9-explorer</AssemblyName>
    <ShaderRuntime Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</ShaderRuntime>
    <ShaderRuntime Condition="'$(ShaderRuntime)' == ''">$(NETCoreSdkRuntimeIdentifier)</ShaderRuntime>
    <Version>1.5.0</Version>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../App/ShaderPreview.cs;../App/NativeShader.cs;../App/PsinPreview.cs;../App/RageResourcePreview.cs" />
    <PackageReference Include="libLLVM.runtime.$(ShaderRuntime)" Version="18.1.3" />
    <ProjectReference Include="../Core/RpfPreview.Core.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
  </ItemGroup>
</Project>
