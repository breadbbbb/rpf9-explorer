<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="RpfExplorer.Desktop.ExplorerWindow" Title="rpf9-explorer" Width="1180" Height="760" MinWidth="800" MinHeight="480">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16" RowSpacing="12">
    <Grid Name="TopBar" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
      <TextBlock Text="rpf9-explorer" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
        <Button Name="OpenFiles" Content="Open files"/>
        <Button Name="OpenDirectory" Content="Open folder"/>
        <Button Name="Configure" Content="Decoder…"/>
        <Button Name="Scan" Content="Scan archive" IsEnabled="False"/>
      </StackPanel>
      <ToggleSwitch Name="Dark" Grid.Column="2" Content="Dark mode" IsChecked="True"/>
    </Grid>
    <Menu Name="MainMenu" Grid.Row="1">
      <MenuItem Header="_Workspace"><MenuItem Name="OpenProject" Header="Open workspace or replacement project…"/><MenuItem Name="SaveProject" Header="Save workspace and edits…"/><MenuItem Name="SaveAs" Header="Save workspace as…"/><Separator/><MenuItem Name="Recovery" Header="Use recovery for new opens"/><MenuItem Name="Report" Header="Save inspection report…"/><MenuItem Name="Clear" Header="Clear loaded sources"/></MenuItem>
      <MenuItem Header="_Edit"><MenuItem Name="Stage" Header="Stage replacement…"/><MenuItem Name="Original" Header="Show original"/><MenuItem Name="Staged" Header="Show staged replacement"/><MenuItem Name="RemoveEdit" Header="Remove replacement"/><Separator/><MenuItem Name="BuildNative" Header="Build native texture…"/><MenuItem Name="PoolCopy" Header="Export modified pool copy…"/></MenuItem>
      <MenuItem Header="_Models"><MenuItem Name="Vehicle" Header="Assemble vehicle"/><MenuItem Name="Wardrobe" Header="Assembled wardrobe…"/><MenuItem Name="Together" Header="Preview selected together"/><MenuItem Name="AddParts" Header="Add selected parts to queue"/><MenuItem Name="Queued" Header="Preview queued parts"/><MenuItem Name="ClearParts" Header="Clear parts"/><Separator/><MenuItem Name="ResetCam" Header="Reset camera"/><MenuItem Name="AssemblyInfo" Header="Assembly details"/></MenuItem>
      <MenuItem Header="_Export"><MenuItem Name="ExtractResults" Header="Extract filtered results…"/><MenuItem Name="ExportTexture" Header="Save displayed texture as DDS…"/><MenuItem Name="ExportShader" Header="Save shader listing…"/><MenuItem Name="ExportAudio" Header="Save decoded audio as WAV…"/></MenuItem>
      <MenuItem Header="_Inspect"><MenuItem Name="SourceInfo" Header="Archive information"/><MenuItem Name="Hex" Header="Show hex"/><MenuItem Name="ReturnPreview" Header="Show asset preview"/></MenuItem>
    </Menu>
    <Grid Grid.Row="2" ColumnDefinitions="3*,6,4*" ColumnSpacing="6">
      <Grid Name="BrowserPane" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="7">
        <StackPanel Spacing="6"><TextBox Name="Search" Watermark="Search names, types or hashes"/>
          <WrapPanel><ComboBox Name="Type" Width="110"/><CheckBox Name="Only" Content="Available only"/><CheckBox Name="Gallery" Content="Thumbnails"/><CheckBox Name="GlobalSearch" Content="All sources" IsChecked="True"/></WrapPanel>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6"><Button Name="FolderUp" Content="Up"/><ComboBox Name="Folders" Grid.Column="1" HorizontalAlignment="Stretch" PlaceholderText="All folders"/></Grid></StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <ComboBox Name="Sources" HorizontalAlignment="Stretch" PlaceholderText="All sources"/>
          <ComboBox Name="Sort" Grid.Column="1" SelectedIndex="0">
            <ComboBoxItem Content="Archive order"/><ComboBoxItem Content="Name"/><ComboBoxItem Content="Largest"/><ComboBoxItem Content="Smallest"/>
          </ComboBox>
        </Grid>
        <ListBox SelectionMode="Multiple" Name="Assets" Grid.Row="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="6"><Image Source="{Binding Thumb}" IsVisible="{Binding ShowThumb}" Width="60" Height="48"/><StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Location}" FontSize="11" Opacity=".65" TextTrimming="CharacterEllipsis"/></StackPanel></StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Size}" VerticalAlignment="Center" FontSize="12"/>
          </Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto">
          <Button Name="Prev" Content="Previous" IsEnabled="False"/><TextBlock Grid.Column="1" Name="Count" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Button Grid.Column="2" Name="Next" Content="Next" IsEnabled="False"/>
        </Grid>
      </Grid>
      <GridSplitter Name="Divider" Grid.Column="1" ResizeDirection="Columns"/>
      <Grid Name="PreviewPane" Grid.Column="2" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
        <TextBlock Name="Caption" Text="Preview" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <WrapPanel Grid.Row="1" Name="Choices" IsVisible="False">
          <ComboBox Name="Choice" MaxWidth="350" MinWidth="145"/>
          <NumericUpDown Name="Slice" Minimum="1" Maximum="1" Value="1" Width="88" IsVisible="False" AutomationProperties.Name="Slice or face"/><NumericUpDown Name="Record" Minimum="1" Maximum="1" Value="1" Increment="1" FormatString="0" Width="100" IsVisible="False" AutomationProperties.Name="Record number"/>
          <ComboBox Name="Links" IsVisible="False" MaxWidth="210" AutomationProperties.Name="Array target"/>
          <Button Name="Follow" Content="Follow array" IsVisible="False"/>
        </WrapPanel>
        <Grid Grid.Row="2">
          <TextBox Name="Details" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="monospace" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
          <Image Name="Picture" Stretch="Uniform" IsVisible="False"/>
        </Grid>
        <StackPanel Grid.Row="3" Spacing="4">
          <StackPanel Name="MediaBar" IsVisible="False"><Slider Name="Timeline" Minimum="0" Maximum="1" AutomationProperties.Name="Playback position"/><WrapPanel><Button Name="Play" Content="Play"/><Button Name="StopMedia" Content="Stop"/><Button Name="Step" Content="Frame +"/><Button Name="Fullscreen" Content="Full screen"/><CheckBox Name="Loop" Content="Loop"/><TextBlock Text="Volume" VerticalAlignment="Center"/><Slider Name="Volume" Minimum="0" Maximum="1" Value="0.6" Width="75"/><TextBlock Name="Clock" VerticalAlignment="Center"/></WrapPanel></StackPanel>
          <WrapPanel>
          <Button Name="Up" Content="Parent archive" IsEnabled="False"/>
          <Button Name="Enter" Content="Open archive" IsVisible="False"/>
          <Button Name="Extract" Content="Extract selected" IsEnabled="False"/>
          <Button Name="ExportObj" Content="Export OBJ" IsVisible="False"/><Button Name="QuickOutfit" Content="Find outfits" IsVisible="False"/><Button Name="QuickVehicle" Content="Assemble vehicle" IsVisible="False"/><Button Name="QuickStage" Content="Stage replacement…" IsEnabled="False"/></WrapPanel>
        </StackPanel>
      </Grid>
    </Grid>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto"><TextBlock Name="Status" VerticalAlignment="Center" Text="Open an archive, folder or decoded resource." TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" Name="Cancel" Content="Cancel" IsVisible="False"/></Grid>
  </Grid>
</Window>
